{
  "expo": {
    "name": "Spark Go",
    "slug": "Tosh",
    "version": "1.0.0",
    "orientation": "portrait",

    "icon": "./assets/ic_launcher.png",

    "scheme": "tosh",
    "userInterfaceStyle": "automatic",

    "ios": {
      "icon": "./assets/ic_launcher.png"
    },

    "android": {
      "package": "com.drivo.mobileapp",
      "icon": "./assets/ic_launcher.png",
      "predictiveBackGestureEnabled": false
    },

    "web": {
      "output": "static",
      "favicon": "./assets/ic_launcher.png"
    },

    "plugins": [
      "expo-router",

      [
        "expo-splash-screen",
        {
          "backgroundColor": "#208AEF",
          "image": "./assets/playstore.png",
          "imageWidth": 220
        }
      ],

      [
        "expo-location",
        {
          "locationWhenInUsePermission": "Allow Spark Go to access your location while you are working.",
          "locationAlwaysAndWhenInUsePermission": "Allow Spark Go to share your live location while your shift is active.",
          "isIosBackgroundLocationEnabled": true,
          "isAndroidBackgroundLocationEnabled": true,
          "isAndroidForegroundServiceEnabled": true
        }
      ],

      "expo-secure-store",
      "expo-localization"
    ],

    "experiments": {
      "typedRoutes": true,
      "reactCompiler": true
    },

    "extra": {
      "eas": {
        "projectId": "94655ac3-adb5-48e7-81d1-8c4047185f4a"
      }
    }
  }
}
